# 后端 API 根路径（浏览器发起的请求前缀）
VITE_API_BASE_URL=/api

# 本地开发：Vite 将 /api 代理到下列地址（修改后需重启 npm run dev）
# 新版查重服务默认与本机 Django：http://127.0.0.1:8000
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# 查重模块 Ninja 路由前缀（相对 VITE_API_BASE_URL）。默认 /v1/duplicate-check → 即 /api/v1/duplicate-check
# VITE_DUPLICATE_API_PREFIX=/v1/duplicate-check

# 模板与存档（占位）：若后端路由不同可调整
# VITE_TEMPLATE_ARCHIVE_API_PREFIX=/template-archive
# VITE_TEMPLATE_ARCHIVE_USE_MOCK=false

# 合规 / Dify WebSocket（可选）
# VITE_WS_DIFY_URL=ws://127.0.0.1:8000/ws/dify_notifications/
# VITE_WS_DIFY_ENABLED=false
