# 后端 API 根路径（可按部署环境修改）
VITE_API_BASE_URL=/api

# 可选：Dify/Celery 解析完成推送（Channels 房间 dify_notifications）。
# 若不配置且 VITE_API_BASE_URL 为完整 URL（含主机），将尝试推导为 {origin}/ws/dify_notifications/
# VITE_WS_DIFY_URL=ws://127.0.0.1:8000/ws/dify_notifications/
# 后端未开 WebSocket 或路径未对全时，可先关闭推送（页面仍用轮询刷新待审核列表）
# VITE_WS_DIFY_ENABLED=false
