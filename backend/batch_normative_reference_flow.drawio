<mxfile host="app.diagrams.net" agent="Cursor" version="24.0.0">
  <diagram id="batch-normative-ref-flow" name="批量合规性评价业务流程">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="2" value="批量合规性评价程序实现业务流程图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150" y="20" width="600" height="40" as="geometry"/></mxCell>
<mxCell id="3" value="开始" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="410" y="70" width="80" height="40" as="geometry"/></mxCell>
<mxCell id="4" value="用户访问批量合规性评价子页面&#xa;进入 /batch-normative-reference" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="130" width="300" height="72" as="geometry"/></mxCell>
<mxCell id="5" value="前端加载批次列表&#xa;GET /api/v1/batch-normative-reference/jobs/&#xa;?page=1&amp;page_size=20" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="222" width="300" height="72" as="geometry"/></mxCell>
<mxCell id="6" value="后端查询 batch_normative_reference_job&#xa;返回分页 {results, total, page, page_size}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="314" width="300" height="72" as="geometry"/></mxCell>
<mxCell id="7" value="前端表格展示批次列表&#xa;显示：批次ID / 状态 / 文件总数 / 已完成 / 失败数 / 创建时间" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="406" width="300" height="72" as="geometry"/></mxCell>
<mxCell id="8" value="用户选择&#xa;操作类型" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="498" width="180" height="90" as="geometry"/></mxCell>
<mxCell id="9" value="① 用户选择多个企标文件&#xa;可选填写 label 批次标签" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="613" width="300" height="72" as="geometry"/></mxCell>
<mxCell id="10" value="② 上传文件&#xa;POST /api/v1/batch-normative-reference/jobs/&#xa;multipart: files[] + label" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="705" width="300" height="72" as="geometry"/></mxCell>
<mxCell id="11" value="后端 create_job_from_uploads&#xa;校验 Dify 配置 / 文件数 / MySQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="797" width="300" height="72" as="geometry"/></mxCell>
<mxCell id="12" value="写入 batch_normative_reference_job&#xa;+ batch_normative_reference_item&#xa;文件存 MEDIA_ROOT/batch_normative_reference/{id}/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="889" width="300" height="72" as="geometry"/></mxCell>
<mxCell id="13" value="投递 Celery 异步任务&#xa;process_batch_normative_reference_job.delay(job_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="981" width="300" height="72" as="geometry"/></mxCell>
<mxCell id="14" value="返回 201 + Job 详情&#xa;前端保存 job_id 并开始轮询" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="1073" width="300" height="72" as="geometry"/></mxCell>
<mxCell id="15" value="③ 轮询进度&#xa;GET /jobs/{job_id}/ 每 1~3 秒" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="1165" width="300" height="72" as="geometry"/></mxCell>
<mxCell id="16" value="job.status&#xa;= completed&#xa;或 failed ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="1257" width="180" height="90" as="geometry"/></mxCell>
<mxCell id="17" value="④ 展示各文件处理结果&#xa;items[].references_resolved&#xa;file_compliance_outcome / error_message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="1367" width="300" height="72" as="geometry"/></mxCell>
<mxCell id="18" value="需要人工&#xa;修订引用?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="1459" width="180" height="90" as="geometry"/></mxCell>
<mxCell id="19" value="人工修订引用&#xa;PATCH /jobs/{job_id}/items/{item_id}/&#xa;Body: { references_resolved: [...] }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="1569" width="300" height="72" as="geometry"/></mxCell>
<mxCell id="20" value="后端 enrich 并持久化 reference_resolution_json&#xa;GET 时重算 file_compliance_outcome" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="1661" width="300" height="72" as="geometry"/></mxCell>
<mxCell id="21" value="结束" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="410" y="1773" width="80" height="40" as="geometry"/></mxCell>
<mxCell id="22" value="查看批次详情&#xa;GET /jobs/{job_id}/&#xa;返回 Job + 全部 items 明细" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="620" width="250" height="72" as="geometry"/></mxCell>
<mxCell id="23" value="前端展示每个企标文件&#xa;引用查新结果 references_resolved&#xa;合规结论 file_compliance_outcome" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="715" width="250" height="72" as="geometry"/></mxCell>
<mxCell id="24" value="可选：单条子项&#xa;GET /jobs/{job_id}/items/{item_id}/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="810" width="250" height="58" as="geometry"/></mxCell>
<mxCell id="25" value="删除批次&#xa;DELETE /jobs/{job_id}/&#xa;删除 DB 记录 + 上传目录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="630" y="650" width="250" height="72" as="geometry"/></mxCell>
<mxCell id="26" value="返回 204 No Content&#xa;前端刷新批次列表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="630" y="745" width="250" height="58" as="geometry"/></mxCell>
<mxCell id="27" value="Dify&#xa;已配置?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="680" y="900" width="120" height="80" as="geometry"/></mxCell>
<mxCell id="28" value="返回 HTTP 503&#xa;detail: 未配置 Dify&#xa;前端弹窗提示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="630" y="1020" width="250" height="72" as="geometry"/></mxCell>
<mxCell id="29" value="【Celery Worker 异步处理】&#xa;job.status → processing&#xa;逐 item: pending → running&#xa;→ Dify 批量工作流 (run_batch_normative_ref_workflow)&#xa;→ 提取 referenced_std_codes&#xa;→ resolve_reference_for_parse_context 谱系查新&#xa;→ 写入 parse_result_json / reference_resolution_json&#xa;→ item.status = completed | failed&#xa;job.status → completed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="820" width="280" height="150" as="geometry"/></mxCell>
