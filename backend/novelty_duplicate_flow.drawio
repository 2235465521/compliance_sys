<mxfile host="app.diagrams.net" agent="Cursor" version="24.0.0">
  <diagram id="novelty-duplicate-flow" name="查新查重业务流程">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="2062" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="2" value="查新 / 查重业务程序实现业务流程图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150" y="20" width="600" height="40" as="geometry"/></mxCell>
<mxCell id="3" value="【查新功能】/api/v1/novelty-search" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="70" width="500" height="30" as="geometry"/></mxCell>
<mxCell id="4" value="开始 (查新)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="410" y="110" width="80" height="40" as="geometry"/></mxCell>
<mxCell id="5" value="用户点击「创建查新任务」&#xa;填写企标号 qb_code&#xa;可选上传企标文件 (multipart file)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="170" width="300" height="72" as="geometry"/></mxCell>
<mxCell id="6" value="POST /api/v1/novelty-search/tasks&#xa;multipart: qb_code + source + file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="262" width="300" height="72" as="geometry"/></mxCell>
<mxCell id="7" value="后端 find_history_for_qb_code&#xa;汇聚合规评价 + 批量规范性引用历史&#xa;生成 reference_sheet / indicators" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="354" width="300" height="72" as="geometry"/></mxCell>
<mxCell id="8" value="存在&#xa;历史引用?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="446" width="180" height="90" as="geometry"/></mxCell>
<mxCell id="9" value="返回 HTTP 422&#xa;empty_history&#xa;该企标号无合规/批量记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;" vertex="1" parent="1"><mxGeometry x="630" y="446" width="250" height="72" as="geometry"/></mxCell>
<mxCell id="10" value="写入 novelty_search_task&#xa;status = pending_confirm&#xa;返回 201 + 专用表 reference_sheet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="561" width="300" height="72" as="geometry"/></mxCell>
<mxCell id="11" value="GET /api/v1/novelty-search/tasks/{id}&#xa;或 GET /tasks 列表&#xa;前端展示专用表待确认" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="653" width="300" height="72" as="geometry"/></mxCell>
<mxCell id="12" value="可选：PATCH /tasks/{id}/reference-sheet&#xa;编辑专用表草稿 rows[]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="745" width="300" height="72" as="geometry"/></mxCell>
<mxCell id="13" value="POST /tasks/{id}/confirm-sheet&#xa;确认专用表并触发比对" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="837" width="300" height="72" as="geometry"/></mxCell>
<mxCell id="14" value="build_compare_rows +&#xa;resolve_reference_for_parse_context&#xa;三列谱系比对 → status = completed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="929" width="300" height="72" as="geometry"/></mxCell>
<mxCell id="15" value="GET /tasks/{id}&#xa;展示 compare_rows / task_conclusion&#xa;可选 GET /tasks/{id}/indicators" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="1021" width="300" height="72" as="geometry"/></mxCell>
<mxCell id="16" value="可选：POST /tasks/{id}/report&#xa;当前返回 HTTP 501&#xa;(PDF 报告尚未实现)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="1113" width="300" height="72" as="geometry"/></mxCell>
<mxCell id="17" value="结束 (查新)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="410" y="1215" width="80" height="40" as="geometry"/></mxCell>
<mxCell id="18" value="说明：查新不走 Dify 关键词检索&#xa;核心是按企标号汇聚历史引用 + 谱系查新比对&#xa;失败任务可 POST /tasks/{id}/retry 重试" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="170" width="280" height="90" as="geometry"/></mxCell>
<mxCell id="19" value="【查重功能】/api/v1/duplicate-check" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="1295" width="500" height="30" as="geometry"/></mxCell>
<mxCell id="20" value="开始 (查重)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="410" y="1335" width="80" height="40" as="geometry"/></mxCell>
<mxCell id="21" value="用户进入查重页面&#xa;输入标准名称关键词&#xa;或填写立项意图 + 候选国标号" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="1395" width="300" height="72" as="geometry"/></mxCell>
<mxCell id="22" value="检查&#xa;类型?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="1487" width="180" height="90" as="geometry"/></mxCell>
<mxCell id="23" value="POST /api/v1/duplicate-check/name-check&#xa;Body: { keyword }&#xa;(兼容 /api/duplicate/name-check/)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="1602" width="260" height="72" as="geometry"/></mxCell>
<mxCell id="24" value="run_name_check&#xa;national_standard_basic LIKE 检索&#xa;+ difflib 相似度评分排序" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="1694" width="260" height="72" as="geometry"/></mxCell>
<mxCell id="25" value="前端展示候选国标列表&#xa;std_code / std_name / similarity&#xa;(无固定重复率阈值分支)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="1786" width="260" height="72" as="geometry"/></mxCell>
<mxCell id="26" value="POST /api/v1/duplicate-check/semantic-check&#xa;Body: intent_text + candidate_ids[]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="630" y="1602" width="260" height="72" as="geometry"/></mxCell>
<mxCell id="27" value="投递 Celery run_semantic_check_task&#xa;(无 Redis 时同步执行)&#xa;run_semantic_ranking 语义排序" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="630" y="1694" width="260" height="72" as="geometry"/></mxCell>
<mxCell id="28" value="返回 task_id + 受理消息&#xa;结果写入日志&#xa;(暂无 GET 轮询接口)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="630" y="1786" width="260" height="72" as="geometry"/></mxCell>
<mxCell id="29" value="结束 (查重)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="410" y="1882" width="80" height="40" as="geometry"/></mxCell>
<mxCell id="30" value="说明：当前查重为「名称快查 + 语义立项」&#xa;非文档全文上传查重，也无 duplicate-check/tasks 接口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="1942" width="300" height="70" as="geometry"/></mxCell>
