# 开发：复制为 `.env` 后按需修改
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 主数据库：MySQL 8.x（设置 MYSQL_DATABASE 即启用；不设置则默认 SQLite）
# STSC 联调（L3 regulation_* 表）：
# MYSQL_DATABASE=STSC_standard_database
# MYSQL_HOST=192.168.10.225
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_PORT=3306
# 库已由 DBA 建好 regulation_* 表时，各 app 首次迁移请用：
#   python manage.py migrate compliance novelty alerting batch_normative_reference --fake-initial
# Step3 引用解析若需 v1 表名，请 DBA 执行 scripts/stsc_l1_compat_views.sql（只读 VIEW）
# 旧库 v1.0-sql（standards_db_v1.0）已不再作为默认目标。

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# 实施日/废止日自动改状态（即将→现行、到期→废止）；仪表盘/统计接口会即时同步；生产建议 Beat 每日 00:05：
#   celery -A config.celery worker -l info
#   celery -A config.celery beat -l info
# 手动全量：python manage.py sync_abolition_status
# Windows：勿用默认 prefork（易触发 billiard/Celery fast_trace_task 报错）；代码对 win32 已默认 threads，也可显式设 solo（单进程串行）
# CELERY_WORKER_POOL=threads
# CELERY_WORKER_POOL=solo

# --- 合规模块（默认与现网一致：不鉴权、同步解析；前端统一对接 /api/v1/compliance）---
# COMPLIANCE_API_AUTH_REQUIRED=false
# true 时须带 Authorization: Bearer <token>；任务列表按 created_by 过滤；跨租户访问 403（created_by 为空的历史任务仍允许访问）
# COMPLIANCE_DIFY_PARSE_ASYNC=false
# true 且 Celery 可投递时，上传后走队列解析（失败自动回退同步）；须启动 celery worker
# COMPLIANCE_PARSE_ASYNC_PENDING_TIMEOUT_SECONDS=600
# 仅当 COMPLIANCE_DIFY_PARSE_ASYNC=true：parse_status=pending 超过该秒数仍无结果则自动置为 failed，避免无限等待
# COMPLIANCE_REQUIRE_MYSQL=false
# true 且当前 Django 默认库非 MySQL 时，依赖业务表的接口返回 503；默认 false 便于 SQLite/Swagger 自测，联调生产建议 true
# GET .../step/3/reference-latest 返回的 pedigree_chain（part_chain）最大字符数；0 表示不截断
# REFERENCE_PEDIGREE_CHAIN_MAX_CHARS=800
# DIFY_HTTP_TIMEOUT_SECONDS=300
# 工作流 run 成功后是否将 Dify 返回的完整 JSON 打印到 stderr（终端可见）；生产可改为 false
# DIFY_LOG_RESPONSE_TO_TERMINAL=true
# 上述打印的最大字符数，超出截断；0 表示不截断
# DIFY_LOG_RESPONSE_MAX_CHARS=200000

# --- Dify 工作流 ①（企标解析）---
# 与 Workflow 应用 API 一致：Base URL 须含 /v1，例如内网 http://192.168.10.225/v1
# DIFY_API_BASE=http://192.168.10.225/v1
# DIFY_API_KEY=app-xxxx
# 可选：指定已发布版本 UUID，则调用 POST /workflows/{id}/run；不填则用 POST /workflows/run
# DIFY_WORKFLOW_1_ID=
# 必填（启用真连时）：Dify「开始」里企标文件变量的 variable 名，与 inputs 键一致（示例：QB_file）
# DIFY_WORKFLOW1_FILES_INPUT_KEY=QB_file
# 文件传参：inputs_single（默认，单文件对象在 inputs）；inputs=数组；files=仅顶层 files；both=双写
# DIFY_WORKFLOW1_FILE_PAYLOAD_MODE=inputs_single
# 工作流 ① 输出外层键名（默认 QB_init_info，值为 JSON 字符串）；与 Dify 末级变量名一致时可不改
# DIFY_WORKFLOW1_OUTPUT_WRAPPER_KEY=QB_init_info
# 可选：blocking（默认）；streaming 尚未在后端实现
# DIFY_WORKFLOW1_RESPONSE_MODE=blocking

# --- Dify 工作流 ②（国标文件 → 指标行，独立应用 API Key）---
# DIFY_WORKFLOW2_API_KEY=app-xxxx
# DIFY_WORKFLOW_2_ID=
# DIFY_WORKFLOW2_FILES_INPUT_KEY=file
# 可选；不填则沿用 DIFY_WORKFLOW1_FILE_PAYLOAD_MODE
# DIFY_WORKFLOW2_FILE_PAYLOAD_MODE=inputs_single
# 若 outputs 中指标列表在某个末级变量里，填变量名
# DIFY_WORKFLOW2_OUTPUT_WRAPPER_KEY=

# --- Dify 工作流 ③（指标对比：enterprise_data + reference_data，独立应用 API Key）---
# DIFY_WORKFLOW3_API_KEY=app-xxxx
# DIFY_WORKFLOW_3_ID=
# DIFY_WORKFLOW3_ENTERPRISE_INPUT_KEY=enterprise_data
# DIFY_WORKFLOW3_REFERENCE_INPUT_KEY=reference_data
# 若表格只在某一 string 输出变量里，填该变量名
# DIFY_WORKFLOW3_OUTPUT_TEXT_KEY=
# DIFY_WORKFLOW3_MAX_INPUT_CHARS=48000

# --- 批量规范性引用评价（独立 Dify 应用；与 DIFY_API_KEY 分离）---
# BATCH_NORMATIVE_REF_DIFY_API_BASE=http://192.168.10.225/v1
# 未设置时可与 DIFY_API_BASE 共用
# BATCH_NORMATIVE_REF_DIFY_API_KEY=app-xxxx
# BATCH_NORMATIVE_REF_FILES_INPUT_KEY=QB_file
# BATCH_NORMATIVE_REF_FILE_PAYLOAD_MODE=inputs_single
# BATCH_NORMATIVE_REF_WORKFLOW_ID=
# BATCH_NORMATIVE_REF_MAX_FILES=100

# --- 国标指标批量入库（Dify 工作流，Celery 异步逐文件串行，与批量合规性评价同模式）---
# STD_INDEX_DIFY_API_KEY=app-xxxx
# STD_INDEX_DIFY_FILES_INPUT_KEY=file
# 可选：在 Dify「开始」增加文本变量 std_code_hint、original_filename 后配置：
# STD_INDEX_DIFY_STD_CODE_HINT_KEY=std_code_hint
# STD_INDEX_DIFY_FILENAME_HINT_KEY=original_filename
# STD_INDEX_BATCH_MAX_FILES=100
# 生产：celery -A config.celery worker -l info
# 本地 dev 默认 STD_INDEX_BATCH_USE_THREAD=true，可不启 Worker（见 config/settings/dev.py）
