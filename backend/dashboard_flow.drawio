<mxfile host="app.diagrams.net" agent="Cursor" version="24.0.0">
  <diagram id="dashboard-flow" name="仪表盘数据聚合业务流程">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1130" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
