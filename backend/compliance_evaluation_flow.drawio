<mxfile host="app.diagrams.net" agent="Cursor" version="24.0.0">
  <diagram id="compliance-eval-flow" name="合规评价业务流程">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1672" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="2" value="合规评价程序实现业务流程图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="20" width="640" height="36" as="geometry"/></mxCell>
<mxCell id="3" value="开始" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="410" y="76" width="80" height="40" as="geometry"/></mxCell>
<mxCell id="4" value="① 用户填写任务信息&#xa;点击「新建评价任务」" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="134" width="400" height="56" as="geometry"/></mxCell>
<mxCell id="5" value="前端调用 POST /api/v1/compliance/evaluations" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="250" y="204" width="400" height="22" as="geometry"/></mxCell>
<mxCell id="6" value="后端创建 ComplianceEvaluationTask&#xa;写入 DB，current_step=1，返回 task_id" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="232" width="400" height="56" as="geometry"/></mxCell>
<mxCell id="7" value="② 用户选择企标文件（PDF/Word）&#xa;点击上传" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="302" width="400" height="56" as="geometry"/></mxCell>
<mxCell id="8" value="POST /api/v1/compliance/evaluations/{task_id}/upload" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="250" y="372" width="400" height="22" as="geometry"/></mxCell>
<mxCell id="9" value="后端保存文件至 MEDIA_ROOT&#xa;更新 uploaded_file_path / parse_status" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="400" width="400" height="56" as="geometry"/></mxCell>
<mxCell id="10" value="COMPLIANCE_DIFY&#xa;_PARSE_ASYNC&#xa;= true ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="350" y="470" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="11" value="是：任务入队 Celery，parse_status=running&#xa;前端轮询 GET /evaluations/{task_id}&#xa;直至 completed | failed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="574" width="400" height="72" as="geometry"/></mxCell>
<mxCell id="12" value="否：Dify 工作流 ① 企标解析（同步）&#xa;POST /v1/files/upload + POST /v1/workflows/run&#xa;QB_init_info → parse_result_json" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="660" width="400" height="80" as="geometry"/></mxCell>
<mxCell id="13" value="Dify 解析&#xa;是否成功？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="350" y="754" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="14" value="是：写入 parse_result_json&#xa;parse_status=completed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="858" width="400" height="56" as="geometry"/></mxCell>
<mxCell id="15" value="否：写入 parse_error&#xa;前端展示错误，可重新上传" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="686" y="754" width="320" height="56" as="geometry"/></mxCell>
<mxCell id="16" value="结束（失败）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="806" y="822" width="80" height="40" as="geometry"/></mxCell>
<mxCell id="17" value="③ Step1 结构审核&#xa;GET .../step/1 → POST .../step/1/confirm&#xa; current_step → 2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="928" width="400" height="64" as="geometry"/></mxCell>
<mxCell id="18" value="④ Step2 引用标准匹配&#xa;GET .../step/2 → POST .../step/2/confirm&#xa;写入 reference_mapping" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="1006" width="400" height="64" as="geometry"/></mxCell>
<mxCell id="19" value="⑤ Step3 引用版本核查&#xa;GET .../step/3/reference-latest&#xa;POST .../step/3/supplements（可选）&#xa;POST .../step/3/confirm → current_step=4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="1084" width="400" height="80" as="geometry"/></mxCell>
<mxCell id="20" value="【步骤 4】Dify 工作流 ② 国标指标提取（按需）&#xa;POST .../step/4/indicators/ensure?target_std_codes=" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="1178" width="400" height="64" as="geometry"/></mxCell>
<mxCell id="21" value="⑥ Step4 指标审核&#xa;GET .../step/4/indicators + 人工审核&#xa;POST .../step/4/confirm → current_step=5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="1256" width="400" height="64" as="geometry"/></mxCell>
<mxCell id="22" value="【步骤 5】Dify 工作流 ③ 指标逐条对比&#xa;GET/POST .../step/5/compare → compare_result_json" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="1334" width="400" height="56" as="geometry"/></mxCell>
<mxCell id="23" value="⑦ Step5 对比结果审核&#xa;POST .../step/5/confirm → current_step=6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="1404" width="400" height="56" as="geometry"/></mxCell>
<mxCell id="24" value="⑧ Step6 生成合规汇总报告&#xa;GET .../summary + GET .../report&#xa;HTML 汇总报告（无 Word 模板）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="1474" width="400" height="64" as="geometry"/></mxCell>
<mxCell id="25" value="结束" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="410" y="1558" width="80" height="40" as="geometry"/></mxCell>
